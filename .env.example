# Backlogs configuration
#
# Every value here is safe to publish: this app has no server, no account,
# and no third-party integration, so there is nothing here that could be a
# secret. Copy to `.env.local` to override anything locally — `.env.local`
# is gitignored.
#
# Only variables prefixed with VITE_ reach the browser bundle. Never put a
# credential behind that prefix in any project: the prefix is what makes a
# value *public*.

# Which dataset the app runs against.
#   personal — your own backlog, stored under `backlogs:*` keys. The default.
#   demo     — the public demo: seeded with sample data on first visit,
#              stored under separate `backlogs:demo:*` keys, resettable
#              from Settings.
VITE_APP_MODE=personal

# Minimum severity that reaches the console.
#   debug | info | warn | error | silent
# Defaults to `debug` in development and `warn` in a production build.
VITE_LOG_LEVEL=debug

# Path the app is served under. `/` for local development and for a
# user/organization GitHub Pages site; `/<repo>/` for a project page.
# Consumed by vite.config.ts at build time, and read back by the router
# out of import.meta.env.BASE_URL so the two cannot disagree.
VITE_BASE_PATH=/

# Build metadata, shown in Settings → About. CI supplies these; a local
# build falls back to the package.json version, "local", and build time.
# VITE_APP_VERSION=1.0.0
# VITE_COMMIT_SHA=abc1234
# VITE_BUILT_AT=2026-01-01T00:00:00.000Z
